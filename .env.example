# Environment Variables Template
PORT=5000
HOST=127.0.0.1
NODE_ENV=development

# Database Configuration
DB_TYPE=sqlite
DB_PATH=database/subscription_management.db

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret-before-deployment
JWT_EXPIRES_IN=24h

# Email / SMTP Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_user
SMTP_PASS=test_password
FROM_EMAIL=billing@brightloopsoftware.com

# System Settings
COMPANY_NAME=Brightloop Software
CURRENCY=USD
DEFAULT_TAX_RATE=10.0
